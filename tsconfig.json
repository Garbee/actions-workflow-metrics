{
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "outDir": "./dist",
  },
  "exclude": [
    "**/*.test.ts"
  ]
}
